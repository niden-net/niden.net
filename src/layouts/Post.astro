---
import type { MarkdownHeading } from 'astro';

import Base from './Base.astro';
import CopyButton from '../components/CopyButton.astro';
import TagPill from '../components/TagPill.astro';
import Toc from '../components/Toc.astro';
import {
    excerpt,
    formatDate,
    formatIsoDate,
    postUrl,
    primarySharedTag,
    readingMinutes,
    type Post,
} from '../lib/posts';

interface Props {
    headings: MarkdownHeading[];
    newer?: Post;
    older?: Post;
    post: Post;
    related: Post[];
}

const { headings, newer, older, post, related } = Astro.props;

const tocEntries = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = tocEntries.length >= 3;
const relatedTag = primarySharedTag(post, related);
---

<Base description={excerpt(post, 160)} title={post.data.title}>
    <div class:list={['split', { 'no-toc': !showToc }]}>
        <article class="article">
            <header class="title-block">
                <div class="meta">
                    <time datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date)}
                    </time>
                    <span class="dot" aria-hidden="true"></span>
                    <span>{readingMinutes(post)} min read</span>
                </div>

                <h1 class="title">{post.data.title}</h1>

                {
                    post.data.tags.length > 0 && (
                        <div class="tags">
                            {post.data.tags.map((tag) => (
                                <TagPill tag={tag} />
                            ))}
                        </div>
                    )
                }
            </header>

            <div class="prose">
                <slot />
            </div>

            {
                related.length > 0 && (
                    <section class="related">
                        <div class="mono-label">
                            Related{relatedTag ? ` - ${relatedTag}` : ''}
                        </div>
                        {related.map((item) => (
                            <a class="related-row" href={postUrl(item)}>
                                <time
                                    class="related-date"
                                    datetime={item.data.date.toISOString()}
                                >
                                    {formatIsoDate(item.data.date)}
                                </time>
                                <span class="related-title">{item.data.title}</span>
                            </a>
                        ))}
                    </section>
                )
            }

            <nav class="pager" aria-label="More posts">
                {
                    older ? (
                        <a class="card" href={postUrl(older)}>
                            <span class="mono-label">Previous</span>
                            <span class="card-title">{older.data.title}</span>
                        </a>
                    ) : (
                        <div class="card empty">
                            <span class="mono-label">Previous</span>
                            <span class="card-title">Nothing earlier</span>
                        </div>
                    )
                }

                {
                    newer ? (
                        <a class="card next" href={postUrl(newer)}>
                            <span class="mono-label">Next</span>
                            <span class="card-title">{newer.data.title}</span>
                        </a>
                    ) : (
                        <div class="card next empty">
                            <span class="mono-label">Next</span>
                            <span class="card-title">Nothing newer</span>
                        </div>
                    )
                }
            </nav>
        </article>

        {
            showToc && (
                <div class="rail">
                    <Toc headings={headings} />
                </div>
            )
        }
    </div>

    <CopyButton />
</Base>

<style>
    .split {
        display: grid;
        /* minmax(0, …) lets the column shrink below its content, so wide code
           blocks scroll inside themselves instead of stretching the page. */
        grid-template-columns: minmax(0, 1fr) 220px;
    }

    .split.no-toc {
        grid-template-columns: 1fr;
    }

    .article {
        min-width: 0;
        padding: 44px 40px 40px var(--gutter);
        border-right: 1px solid var(--line);
    }

    .split.no-toc .article {
        border-right: 0;
    }

    .rail {
        padding: 44px 24px;
        align-self: flex-start;
        position: sticky;
        top: calc(var(--header-h) + 24px);
    }

    /* Title block */

    .title-block {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 30px;
    }

    .meta {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 11.5px;
        line-height: 1;
        color: var(--ink-dim);
    }

    .dot {
        width: 3px;
        height: 3px;
        border-radius: var(--r-pill);
        background: var(--ink-dim);
    }

    .title {
        max-width: 26ch;
        font-size: 44px;
        line-height: 1.05;
        font-weight: 700;
        letter-spacing: -0.035em;
        text-wrap: pretty;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    /* Related */

    .related {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 44px;
        padding-top: 26px;
        border-top: 1px solid var(--line);
    }

    .related :global(.mono-label) {
        margin-bottom: 8px;
    }

    .related-row {
        display: flex;
        gap: 20px;
        align-items: baseline;
        padding: 9px 0;
        color: var(--ink);
    }

    .related-row:hover {
        background: var(--row-hover);
    }

    .related-date {
        width: 84px;
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--ink-dim);
    }

    .related-title {
        font-size: 15.5px;
        font-weight: 500;
    }

    /* Prev / next */

    .pager {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-top: 32px;
    }

    .card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: var(--r-card);
        color: var(--ink);
    }

    .card.next {
        text-align: right;
        align-items: flex-end;
    }

    .card.empty {
        opacity: 0.45;
        pointer-events: none;
    }

    .card:not(.empty):hover {
        background: var(--row-hover);
    }

    .card-title {
        font-size: 15.5px;
        font-weight: 500;
        line-height: 1.3;
    }

    @media (max-width: 900px) {
        .split,
        .split.no-toc {
            grid-template-columns: 1fr;
        }

        .article {
            padding: 32px 24px;
            border-right: 0;
        }

        .rail {
            position: static;
            padding: 0 24px 32px;
        }
    }

    @media (max-width: 720px) {
        .title {
            font-size: 30px;
        }

        .pager {
            grid-template-columns: 1fr;
        }

        .card.next {
            text-align: left;
            align-items: flex-start;
        }
    }
</style>
