---
interface Props {
    compact?: boolean;
}

const { compact = false } = Astro.props;
const startYear = 2022;
---

<footer class:list={['footer', { compact }]}>
    <div>&copy; {startYear}&ndash;present niden.net</div>
    <div>Astro</div>
</footer>

<style>
    .footer {
        display: flex;
        justify-content: space-between;
        padding: 20px var(--gutter);
        border-top: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: 11.5px;
        line-height: 1;
        color: var(--ink-dim);
    }

    .footer.compact {
        padding: 20px 32px;
    }

    @media (max-width: 900px) {
        .footer,
        .footer.compact {
            padding-left: 24px;
            padding-right: 24px;
        }
    }
</style>
