---
import Base from '../../layouts/Base.astro';
import TagPill from '../../components/TagPill.astro';
import { allPosts, tagCounts } from '../../lib/posts';

const posts = await allPosts();
const tags = tagCounts(posts);
---

<Base title="Tags" activeHref="/tag" compact={true} width={740}>
    <div class="body">
        <div class="mono-label">Tags</div>

        <div class="title-row">
            <h1 class="title">All tags</h1>
            <span class="count">{tags.length} tags &middot; {posts.length} posts</span>
        </div>

        <div class="tags">
            {tags.map((item) => <TagPill tag={item.tag} count={item.count} size="md" />)}
        </div>
    </div>
</Base>

<style>
    .body {
        display: flex;
        flex-direction: column;
        gap: 26px;
        padding: 34px 32px 36px;
    }

    .title-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
    }

    .title {
        font-size: 38px;
        line-height: 1;
        font-weight: 700;
    }

    .count {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--ink-dim);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    @media (max-width: 900px) {
        .body {
            padding: 28px 24px 32px;
        }
    }
</style>
