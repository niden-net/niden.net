---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import Callout from '../../components/Callout.astro';
import PostLayout from '../../layouts/Post.astro';
import '../../styles/prose.css';
import { allPosts, relatedPosts } from '../../lib/posts';

export const getStaticPaths = (async () => {
    const posts = await allPosts();

    return posts.map((post, position) => ({
        params: { slug: post.id },
        props: {
            /* The list is newest first, so the neighbor before is the newer one. */
            newer: posts[position - 1],
            older: posts[position + 1],
            post,
            related: relatedPosts(post, posts),
        },
    }));
}) satisfies GetStaticPaths;

const { newer, older, post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout
    headings={headings}
    newer={newer}
    older={older}
    post={post}
    related={related}
>
    <Content components={{ Callout }} />
</PostLayout>
